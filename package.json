{
  "name": "northstar-vault",
  "version": "1.0.0",
  "private": true,
  "description": "A privacy-first Gemini decision journal for the Gen AI Academy APAC Ideathon.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "build": "node scripts/build-icons.mjs && tailwindcss -i ./ui/tailwind.css -o ./public/styles.css --minify",
    "dev:css": "tailwindcss -i ./ui/tailwind.css -o ./public/styles.css --watch",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:ui": "npm run build && firebase emulators:exec --only auth,firestore --project demo-northstar-security --config firebase.test.json \"node scripts/preview-ui.mjs\"",
    "test:security": "firebase emulators:exec --only auth,firestore --project demo-northstar-security --config firebase.test.json \"node --test --test-concurrency=1 security/*.test.js\"",
    "check": "npm run format:check && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "firebase-tools": {
      "@google-cloud/pubsub": "6.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@tailwindcss/cli": "4.3.3",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "firebase": "12.18.0",
    "firebase-tools": "15.28.1",
    "globals": "17.11.0",
    "lucide-static": "1.34.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3"
  }
}
