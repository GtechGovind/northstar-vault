# Public Firebase web configuration. These identifiers are not secrets, but are
# injected at runtime so the same image can be promoted between environments.
FIREBASE_API_KEY=replace-me
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=replace-me

# Load the Gemini Developer API key server-side from Secret Manager; do not
# commit credentials. The default mode fails closed when this key is absent.
GEMINI_API_KEY=
# Set to 1 explicitly only for the documented Vertex AI rollback mode.
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_CLOUD_PROJECT=your-project
PORT=8080
