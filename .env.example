# Public Firebase web configuration. These identifiers are not secrets, but are
# injected at runtime so the same image can be promoted between environments.
FIREBASE_API_KEY=replace-me
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=replace-me

# Mount this value from Google Cloud Secret Manager in Cloud Run.
GEMINI_API_KEY=secret-manager-only
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=your-project
PORT=8080
